{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foliofilm episode",
  "type": "object",
  "required": ["id","title","format","question","sources","shots"],
  "properties": {
    "id":{"$ref":"#/$defs/slug"},"title":{"type":"string"},"question":{"type":"string"},
    "format":{"enum":["short","long"]},
    "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["id","title","url","locator","support"],"properties":{"id":{"$ref":"#/$defs/slug"},"url":{"type":"string","format":"uri"},"title":{"type":"string"},"locator":{"type":"string"},"support":{"type":"string"}}}},
    "shots":{"type":"array","minItems":1,"items":{"type":"object","required":["id","heading","voice","direction","refs","component"],"properties":{
      "id":{"$ref":"#/$defs/slug"},"heading":{"type":"string"},"voice":{"type":"string"},"spoken":{"type":"string"},"section":{"type":"string"},"direction":{"type":"string"},"refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/slug"}},"component":{"$ref":"#/$defs/slug"},
      "objects":{"$ref":"#/$defs/objects"},"actions":{"type":"array","items":{"$ref":"#/$defs/action"}},
      "params":{"type":"object"},"speaker":{"type":"object"},"camera":{"type":"object"},"transition":{"type":"string"},"curve":{"type":"string"},"motion":{"type":"number","minimum":0},"continuous":{"type":"boolean"},"hold":{"type":"number","minimum":0},"lead":{"type":"number","minimum":0},"motionAt":{"type":"object","required":["sentence"],"properties":{"sentence":{"type":"integer","minimum":1},"edge":{"enum":["start","end"]},"offset":{"type":"number"}}},"audioAfter":{"type":"object","required":["file","credit","rights"],"properties":{"file":{"type":"string"},"gainDb":{"type":"number"},"credit":{"type":"string"},"rights":{"type":"string"}}}
    }}}
  },
  "$defs":{
    "objects":{"type":"object","propertyNames":{"$ref":"#/$defs/slug"},"additionalProperties":{"type":"object","additionalProperties":false,"required":["anchor"],"properties":{"anchor":{"type":"array","prefixItems":[{"type":"number","minimum":0,"maximum":1000},{"type":"number","minimum":0,"maximum":820}],"minItems":2,"maxItems":2},"opacity":{"type":"number","minimum":0,"maximum":1},"properties":{"type":"object","propertyNames":{"$ref":"#/$defs/slug"},"additionalProperties":{"type":"number"}}}}},
    "actionAnchor":{"type":"object","additionalProperties":false,"oneOf":[{"required":["quote"]},{"required":["mark"],"not":{"required":["occurrence"]}}],"properties":{"quote":{"type":"string","minLength":1},"occurrence":{"type":"integer","minimum":1},"mark":{"$ref":"#/$defs/slug"},"edge":{"enum":["start","end"]},"offset":{"type":"number"}}},
    "action":{"type":"object","additionalProperties":false,"required":["id","type","at"],"properties":{"id":{"$ref":"#/$defs/slug"},"type":{"enum":["pan","zoom","reveal","animate"]},"target":{"$ref":"#/$defs/slug"},"property":{"$ref":"#/$defs/slug"},"to":{"type":"number"},"scale":{"type":"number","exclusiveMinimum":0},"opacity":{"type":"number","minimum":0,"maximum":1},"at":{"$ref":"#/$defs/actionAnchor"},"duration":{"type":"number","minimum":0},"curve":{"oneOf":[{"enum":["linear","smooth","smoother","out-cubic"]},{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number","minimum":0,"maximum":1}}]}},"allOf":[{"if":{"properties":{"type":{"enum":["pan","reveal"]}}},"then":{"required":["target"]}},{"if":{"properties":{"type":{"const":"animate"}}},"then":{"required":["target","property","to"]}},{"if":{"properties":{"type":{"const":"zoom"}}},"then":{"required":["scale"]}}]},
    "slug":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"}}
}
